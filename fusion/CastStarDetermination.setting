		MOTE_1 = RectangleMask {
			CtrlWZoom = false,
			NameSet = true,
			Inputs = {
				MaskWidth = Input { Value = 110, },
				MaskHeight = Input { Value = 125, },
				PixelAspect = Input { Value = { 1, 1 }, },
				UseFrameFormatSettings = Input { Value = 0, },
				ClippingMode = Input { Value = FuID { "None" }, },
				Center = Input { Expression = "Point(0.5 + ((CTRL.MoteRadius - 6 + 0) * (1 - pow(min(max(((time - CTRL.StartFrame) + 1 - 0.0) / 5, 0), 1), 2)) + 6) * (0.939373 - (1.2 * min(max(((time - CTRL.StartFrame) + 1 - 0.0) / 5, 0), 1)) * 0.342898) / 110, 0.504 - 1.3 * ((CTRL.MoteRadius - 6 + 0) * (1 - pow(min(max(((time - CTRL.StartFrame) + 1 - 0.0) / 5, 0), 1), 2)) + 6) * (0.342898 + (1.2 * min(max(((time - CTRL.StartFrame) + 1 - 0.0) / 5, 0), 1)) * 0.939373) / 125)", },
				Width = Input { Expression = "iif(min(max(((time - CTRL.StartFrame) + 1 - 0.0) / 5, 0), 1) < 0.001, 0, iif(min(max(((time - CTRL.StartFrame) + 1 - 0.0) / 5, 0), 1) > 0.999, 0, 1)) * 2 / 110", },
				Height = Input { Expression = "iif(min(max(((time - CTRL.StartFrame) + 1 - 0.0) / 5, 0), 1) < 0.001, 0, iif(min(max(((time - CTRL.StartFrame) + 1 - 0.0) / 5, 0), 1) > 0.999, 0, 1)) * 2 / 110", },
			},
			ViewInfo = OperatorInfo { Pos = { 440, -440 } },
		},
		MOTE_2 = RectangleMask {
			CtrlWZoom = false,
			NameSet = true,
			Inputs = {
				MaskWidth = Input { Value = 110, },
				MaskHeight = Input { Value = 125, },
				PixelAspect = Input { Value = { 1, 1 }, },
				UseFrameFormatSettings = Input { Value = 0, },
				ClippingMode = Input { Value = FuID { "None" }, },
				Center = Input { Expression = "Point(0.5 + ((CTRL.MoteRadius - 6 + 6) * (1 - pow(min(max(((time - CTRL.StartFrame) + 1 - 1.2) / 5, 0), 1), 2)) + 6) * (0.558418 - (1.2 * min(max(((time - CTRL.StartFrame) + 1 - 1.2) / 5, 0), 1)) * 0.82956) / 110, 0.504 - 1.3 * ((CTRL.MoteRadius - 6 + 6) * (1 - pow(min(max(((time - CTRL.StartFrame) + 1 - 1.2) / 5, 0), 1), 2)) + 6) * (0.82956 + (1.2 * min(max(((time - CTRL.StartFrame) + 1 - 1.2) / 5, 0), 1)) * 0.558418) / 125)", },
				Width = Input { Expression = "iif(min(max(((time - CTRL.StartFrame) + 1 - 1.2) / 5, 0), 1) < 0.001, 0, iif(min(max(((time - CTRL.StartFrame) + 1 - 1.2) / 5, 0), 1) > 0.999, 0, 1)) * 2 / 110", },
				Height = Input { Expression = "iif(min(max(((time - CTRL.StartFrame) + 1 - 1.2) / 5, 0), 1) < 0.001, 0, iif(min(max(((time - CTRL.StartFrame) + 1 - 1.2) / 5, 0), 1) > 0.999, 0, 1)) * 2 / 110", },
			},
			ViewInfo = OperatorInfo { Pos = { 330, -440 } },
		},
		MOTE_3 = RectangleMask {
			CtrlWZoom = false,
			NameSet = true,
			Inputs = {
				MaskWidth = Input { Value = 110, },
				MaskHeight = Input { Value = 125, },
				PixelAspect = Input { Value = { 1, 1 }, },
				UseFrameFormatSettings = Input { Value = 0, },
				ClippingMode = Input { Value = FuID { "None" }, },
				EffectMask = Input { SourceOp = "MOTE_2", Source = "Mask", },
				Center = Input { Expression = "Point(0.5 + ((CTRL.MoteRadius - 6 + 3) * (1 - pow(min(max(((time - CTRL.StartFrame) + 1 - 0.5) / 5, 0), 1), 2)) + 6) * (-0.035833 - (1.2 * min(max(((time - CTRL.StartFrame) + 1 - 0.5) / 5, 0), 1)) * 0.999358) / 110, 0.504 - 1.3 * ((CTRL.MoteRadius - 6 + 3) * (1 - pow(min(max(((time - CTRL.StartFrame) + 1 - 0.5) / 5, 0), 1), 2)) + 6) * (0.999358 + (1.2 * min(max(((time - CTRL.StartFrame) + 1 - 0.5) / 5, 0), 1)) * -0.035833) / 125)", },
				Width = Input { Expression = "iif(min(max(((time - CTRL.StartFrame) + 1 - 0.5) / 5, 0), 1) < 0.001, 0, iif(min(max(((time - CTRL.StartFrame) + 1 - 0.5) / 5, 0), 1) > 0.999, 0, 1)) * 2 / 110", },
				Height = Input { Expression = "iif(min(max(((time - CTRL.StartFrame) + 1 - 0.5) / 5, 0), 1) < 0.001, 0, iif(min(max(((time - CTRL.StartFrame) + 1 - 0.5) / 5, 0), 1) > 0.999, 0, 1)) * 2 / 110", },
			},
			ViewInfo = OperatorInfo { Pos = { 330, -400 } },
		},
		MOTE_4 = RectangleMask {
			CtrlWZoom = false,
			NameSet = true,
			Inputs = {
				MaskWidth = Input { Value = 110, },
				MaskHeight = Input { Value = 125, },
				PixelAspect = Input { Value = { 1, 1 }, },
				UseFrameFormatSettings = Input { Value = 0, },
				ClippingMode = Input { Value = FuID { "None" }, },
				EffectMask = Input { SourceOp = "MOTE_1", Source = "Mask", },
				Center = Input { Expression = "Point(0.5 + ((CTRL.MoteRadius - 6 + 8) * (1 - pow(min(max(((time - CTRL.StartFrame) + 1 - 2.0) / 5, 0), 1), 2)) + 6) * (-0.616397 - (1.2 * min(max(((time - CTRL.StartFrame) + 1 - 2.0) / 5, 0), 1)) * 0.787435) / 110, 0.504 - 1.3 * ((CTRL.MoteRadius - 6 + 8) * (1 - pow(min(max(((time - CTRL.StartFrame) + 1 - 2.0) / 5, 0), 1), 2)) + 6) * (0.787435 + (1.2 * min(max(((time - CTRL.StartFrame) + 1 - 2.0) / 5, 0), 1)) * -0.616397) / 125)", },
				Width = Input { Expression = "iif(min(max(((time - CTRL.StartFrame) + 1 - 2.0) / 5, 0), 1) < 0.001, 0, iif(min(max(((time - CTRL.StartFrame) + 1 - 2.0) / 5, 0), 1) > 0.999, 0, 1)) * 2 / 110", },
				Height = Input { Expression = "iif(min(max(((time - CTRL.StartFrame) + 1 - 2.0) / 5, 0), 1) < 0.001, 0, iif(min(max(((time - CTRL.StartFrame) + 1 - 2.0) / 5, 0), 1) > 0.999, 0, 1)) * 2 / 110", },
			},
