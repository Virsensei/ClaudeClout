{
	Tools = ordered() {
		CONTROLS = Underlay {
			CtrlWZoom = false,
			NameSet = true,
			Inputs = { Comments = Input { Value = "Open CTRL: timing, layers on/off, sizes, shake, palette, crisp pixels. Everything else reads from it.", }, },
			ViewInfo = UnderlayInfo { Pos = { -70, -400 }, Size = { 140, 160 } },
			Colors = { TileColor = { R = 0.35, G = 0.35, B = 0.4 }, },
		},
		L1_MOTES = Underlay {
			CtrlWZoom = false,
			NameSet = true,
			Inputs = { Comments = Input { Value = "Motes of determination spiral into the star before the burst (Start Frame .. Burst Frame - 1).", }, },
			ViewInfo = UnderlayInfo { Pos = { 150, -480 }, Size = { 360, 600 } },
			Colors = { TileColor = { R = 0.55, G = 0.12, B = 0.18 }, },
		},
		L2_FLARE = Underlay {
			CtrlWZoom = false,
			NameSet = true,
			Inputs = { Comments = Input { Value = "Cross flare on the burst: full length, then 3/4, 1/2, 1/4 (white on the burst frame).", }, },
			ViewInfo = UnderlayInfo { Pos = { 590, -240 }, Size = { 360, 360 } },
			Colors = { TileColor = { R = 0.6, G = 0.3, B = 0.1 }, },
		},
		L3_SHOCKWAVE = Underlay {
			CtrlWZoom = false,
			NameSet = true,
			Inputs = { Comments = Input { Value = "Two rings expanding from the centre after the burst (thin one 5 frames, thick one 8 frames).", }, },
			ViewInfo = UnderlayInfo { Pos = { 1030, -120 }, Size = { 250, 240 } },
			Colors = { TileColor = { R = 0.45, G = 0.45, B = 0.5 }, },
		},
		L4_MINI_STARS = Underlay {
			CtrlWZoom = false,
			NameSet = true,
			Inputs = { Comments = Input { Value = "Eight little stars bloom out after the burst and each winks away on its own frame.", }, },
			ViewInfo = UnderlayInfo { Pos = { 1360, -400 }, Size = { 250, 520 } },
			Colors = { TileColor = { R = 0.6, G = 0.5, B = 0.1 }, },
		},
		L5_SAVE_STAR = Underlay {
			CtrlWZoom = false,
			NameSet = true,
			Inputs = { Comments = Input { Value = "The save star: pops in, grows while charging, bursts, settles, pops away at Exit Frame. STAR_Base drives size, spin and position; the other shapes follow it.", }, },
			ViewInfo = UnderlayInfo { Pos = { 1690, -160 }, Size = { 910, 280 } },
			Colors = { TileColor = { R = 0.7, G = 0.1, B = 0.15 }, },
		},
		L6_TWINKLE = Underlay {
			CtrlWZoom = false,
			NameSet = true,
			Inputs = { Comments = Input { Value = "The last twinkle after the star pops away (frames Exit+4 .. Exit+7).", }, },
			ViewInfo = UnderlayInfo { Pos = { 2680, -120 }, Size = { 360, 240 } },
			Colors = { TileColor = { R = 0.6, G = 0.5, B = 0.55 }, },
		},
		OUTPUT = Underlay {
			CtrlWZoom = false,
			NameSet = true,
			Inputs = { Comments = Input { Value = "Screen shake, crisp 1-bit pixels, then x2 nearest-neighbour upscale to 220 x 250. Connect OUTPUT_220x250 to MediaOut / a Saver.", }, },
			ViewInfo = UnderlayInfo { Pos = { 3120, -80 }, Size = { 360, 160 } },
			Colors = { TileColor = { R = 0.25, G = 0.4, B = 0.3 }, },
		},
		CANVAS = Background {
			CtrlWZoom = false,
			NameSet = true,
			Inputs = {
				Width = Input { Value = 110, },
				Height = Input { Value = 125, },
				UseFrameFormatSettings = Input { Value = 0, },
				TopLeftAlpha = Input { Value = 0, },
			},
			ViewInfo = OperatorInfo { Pos = { 0, 0 } },
		},
		CTRL = AlphaDivide {
			CtrlWZoom = false,
			NameSet = true,
			Inputs = {
				StartFrame = Input { Value = 0, },
				BurstFrame = Input { Value = 7, },
				ExitFrame = Input { Value = 15, },
				ShowMotes = Input { Value = 1, },
				ShowFlare = Input { Value = 1, },
				ShowShockwave = Input { Value = 1, },
				ShowMiniStars = Input { Value = 1, },
				ShowStar = Input { Value = 1, },
				ShowTwinkle = Input { Value = 1, },
				ShowShake = Input { Value = 1, },
				StarSize = Input { Value = 16.5, },
				BurstSize = Input { Value = 30, },
				MoteRadius = Input { Value = 36, },
				FlareLength = Input { Value = 48, },
				ShockSize = Input { Value = 0.85, },
				MiniDistance = Input { Value = 28, },
				ShakeStrength = Input { Value = 1.5, },
				Crisp = Input { Value = 1, },
				InkRed = Input { Value = 0.160784, },
				InkGreen = Input { Value = 0.0, },
				InkBlue = Input { Value = 0.019608, },
				InkAlpha = Input { Value = 1.0, },
				BaseRed = Input { Value = 1.0, },
				BaseGreen = Input { Value = 0.0, },
				BaseBlue = Input { Value = 0.113725, },
				BaseAlpha = Input { Value = 1.0, },
				LightRed = Input { Value = 1.0, },
				LightGreen = Input { Value = 0.45098, },
				LightBlue = Input { Value = 0.513725, },
				LightAlpha = Input { Value = 1.0, },
				PaleRed = Input { Value = 1.0, },
				PaleGreen = Input { Value = 0.780392, },
				PaleBlue = Input { Value = 0.803922, },
				PaleAlpha = Input { Value = 1.0, },
				WhiteRed = Input { Value = 1.0, },
				WhiteGreen = Input { Value = 1.0, },
				WhiteBlue = Input { Value = 1.0, },
				WhiteAlpha = Input { Value = 1.0, },
				Age = Input { Expression = "time - CTRL.BurstFrame", },
				ExitU = Input { Expression = "min(max((time - CTRL.ExitFrame) / 4, 0), 1)", },
				OutScale = Input { Expression = "iif(CTRL.ExitU < 0.001, 1, iif(CTRL.ExitU > 0.999, 0, iif(CTRL.ExitU < 0.3, 1 + 0.6 * CTRL.ExitU, 1.18 * pow(1 - (CTRL.ExitU - 0.3) / 0.7, 2))))", },
				StarR = Input { Expression = "iif((time - CTRL.StartFrame) < 0, 0, iif(CTRL.Age < -0.5, iif((time - CTRL.StartFrame) < 0.5, 0.42, iif((time - CTRL.StartFrame) < 1.5, 0.79, 0.67 + 0.21 * min(max(((time - CTRL.StartFrame) - 2) / max(CTRL.BurstFrame - CTRL.StartFrame - 3, 1), 0), 1))) * CTRL.StarSize, iif(CTRL.Age < 0.5, CTRL.BurstSize, iif(CTRL.Age < 1.5, CTRL.BurstSize * 0.7, iif(CTRL.Age < 2.5, CTRL.StarSize * 0.91, iif(CTRL.Age < 3.5, CTRL.StarSize * 1.06, CTRL.StarSize))))) * CTRL.OutScale)", },
				Odd = Input { Expression = "time - floor(time / 2) * 2", },
				StarSpin = Input { Expression = "iif(CTRL.Age < -0.5, 1, iif(CTRL.Age < 0.5, 0, 1)) * iif(CTRL.Odd < 0.5, 4, -4)", },
				Shiver = Input { Expression = "iif(CTRL.Age < -2.5, 0, iif(CTRL.Age < -0.5, iif(CTRL.Odd < 0.5, -1, 1), 0))", },
				ShakeX = Input { Expression = "floor(CTRL.ShowShake * CTRL.ShakeStrength * iif(CTRL.Age < -0.5, 0, iif(CTRL.Age < 0.5, 2, iif(CTRL.Age < 1.5, -2, iif(CTRL.Age < 2.5, 1, iif(CTRL.Age < 3.5, -1, 0))))) + 0.5)", },
				ShakeY = Input { Expression = "CTRL.ShowShake * min(CTRL.ShakeStrength, 1) * iif(CTRL.Age < 0.5, 0, iif(CTRL.Age < 1.5, -1, iif(CTRL.Age < 2.5, 1, 0)))", },
			},
			ViewInfo = OperatorInfo { Pos = { 0, -320 } },
			UserControls = ordered() {
				TimingTab = { LINKS_Name = "TIMING", LINKID_DataType = "Number", INPID_InputControl = "LabelControl", LBLC_DropDownButton = true, LBLC_NumInputs = 3, },
				StartFrame = { LINKS_Name = "Start Frame", LINKID_DataType = "Number", INPID_InputControl = "SliderControl", INP_Default = 0, INP_MinScale = 0, INP_MaxScale = 100, INP_Integer = true, },
				BurstFrame = { LINKS_Name = "Burst Frame", LINKID_DataType = "Number", INPID_InputControl = "SliderControl", INP_Default = 7, INP_MinScale = 1, INP_MaxScale = 100, INP_Integer = true, },
				ExitFrame = { LINKS_Name = "Exit Frame (star pops away)", LINKID_DataType = "Number", INPID_InputControl = "SliderControl", INP_Default = 15, INP_MinScale = 2, INP_MaxScale = 100, INP_Integer = true, },
				LayersTab = { LINKS_Name = "LAYERS (on / off)", LINKID_DataType = "Number", INPID_InputControl = "LabelControl", LBLC_DropDownButton = true, LBLC_NumInputs = 7, },
				ShowMotes = { LINKS_Name = "1 Motes", LINKID_DataType = "Number", INPID_InputControl = "CheckboxControl", INP_Default = 1, },
				ShowFlare = { LINKS_Name = "2 Cross Flare", LINKID_DataType = "Number", INPID_InputControl = "CheckboxControl", INP_Default = 1, },
				ShowShockwave = { LINKS_Name = "3 Shockwave", LINKID_DataType = "Number", INPID_InputControl = "CheckboxControl", INP_Default = 1, },
				ShowMiniStars = { LINKS_Name = "4 Mini Stars", LINKID_DataType = "Number", INPID_InputControl = "CheckboxControl", INP_Default = 1, },
				ShowStar = { LINKS_Name = "5 Save Star", LINKID_DataType = "Number", INPID_InputControl = "CheckboxControl", INP_Default = 1, },
				ShowTwinkle = { LINKS_Name = "6 Final Twinkle", LINKID_DataType = "Number", INPID_InputControl = "CheckboxControl", INP_Default = 1, },
				ShowShake = { LINKS_Name = "Screen Shake", LINKID_DataType = "Number", INPID_InputControl = "CheckboxControl", INP_Default = 1, },
				LookTab = { LINKS_Name = "LOOK", LINKID_DataType = "Number", INPID_InputControl = "LabelControl", LBLC_DropDownButton = true, LBLC_NumInputs = 8, },
				StarSize = { LINKS_Name = "Star Size (px)", LINKID_DataType = "Number", INPID_InputControl = "SliderControl", INP_Default = 16.5, INP_MinScale = 4, INP_MaxScale = 40, },
				BurstSize = { LINKS_Name = "Burst Size (px)", LINKID_DataType = "Number", INPID_InputControl = "SliderControl", INP_Default = 30, INP_MinScale = 4, INP_MaxScale = 50, },
				MoteRadius = { LINKS_Name = "Motes Start Distance (px)", LINKID_DataType = "Number", INPID_InputControl = "SliderControl", INP_Default = 36, INP_MinScale = 8, INP_MaxScale = 50, },
				FlareLength = { LINKS_Name = "Flare Length (px)", LINKID_DataType = "Number", INPID_InputControl = "SliderControl", INP_Default = 48, INP_MinScale = 0, INP_MaxScale = 60, },
				ShockSize = { LINKS_Name = "Shockwave Size", LINKID_DataType = "Number", INPID_InputControl = "SliderControl", INP_Default = 0.85, INP_MinScale = 0, INP_MaxScale = 2, },
				MiniDistance = { LINKS_Name = "Mini Stars Distance (px)", LINKID_DataType = "Number", INPID_InputControl = "SliderControl", INP_Default = 28, INP_MinScale = 0, INP_MaxScale = 40, },
				ShakeStrength = { LINKS_Name = "Shake Strength", LINKID_DataType = "Number", INPID_InputControl = "SliderControl", INP_Default = 1.5, INP_MinScale = 0, INP_MaxScale = 4, },
				Crisp = { LINKS_Name = "Crisp Pixels (1-bit alpha)", LINKID_DataType = "Number", INPID_InputControl = "CheckboxControl", INP_Default = 1, },
				ColorTab = { LINKS_Name = "PALETTE", LINKID_DataType = "Number", INPID_InputControl = "LabelControl", LBLC_DropDownButton = true, LBLC_NumInputs = 20, },
				InkRed = { LINKS_Name = "Ink", LINKID_DataType = "Number", INPID_InputControl = "ColorControl", INP_Default = 0.160784, INP_MinScale = 0, INP_MaxScale = 1, IC_ControlGroup = 1, IC_ControlID = 0, },
				InkGreen = { LINKS_Name = "Green", LINKID_DataType = "Number", INPID_InputControl = "ColorControl", INP_Default = 0.0, INP_MinScale = 0, INP_MaxScale = 1, IC_ControlGroup = 1, IC_ControlID = 1, },
