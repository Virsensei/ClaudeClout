				PaleBlue = { LINKS_Name = "Blue", LINKID_DataType = "Number", INPID_InputControl = "ColorControl", INP_Default = 0.803922, INP_MinScale = 0, INP_MaxScale = 1, IC_ControlGroup = 4, IC_ControlID = 2, },
